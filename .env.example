# Faceless Finesse environment variables (validated in lib/env.ts).
# Copy to .env.local for `next dev`, or .dev.vars for `wrangler dev`.
# Production: `wrangler secret put <NAME>` (never commit real values).
# NEXT_PUBLIC_* values are inlined into the browser bundle: never put secrets there.

# --- App ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Whop (https://whop.com/dashboard -> Developer -> your app) ----------
NEXT_PUBLIC_WHOP_APP_ID=app_xxxxxxxxxxxx
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=

# --- Supabase (Project settings -> API) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Used to mint user JWTs (sub = users.id) after Whop verification, so RLS applies.
SUPABASE_JWT_SECRET=

# --- treg.to (keyword volume, SERP, trends; server-side only) ------------
TREG_API_KEY=
TREG_DAILY_CAP_USD=5
TREG_PER_CALL_CAP_USD=0.05

# --- AI providers (internal AI Gateway; see docs/plan/ai-model-options.md)
GEMINI_API_KEY=
GROQ_API_KEY=
FAL_KEY=
XAI_API_KEY=

# --- Social publishing ------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Security -----------------------------------------------------------------
# AES-256-GCM key for social tokens: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Shared secret for manual job triggers (>= 32 chars): openssl rand -hex 32
CRON_SECRET=

# --- Email + monitoring ---------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=support@facelessfinesse.com
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Cloudflare bindings (R2 MEDIA_BUCKET, KV CACHE_KV, Queues, Workers AI) are
# configured in wrangler.jsonc, not here.
